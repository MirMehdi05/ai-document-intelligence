# Local development
APP_ENV=development
APP_PASSWORD=

# Local Ollama (default for development)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest

# Optional hosted OpenAI-compatible LLM (e.g. Groq)
# Set LLM_PROVIDER=openai-compatible to use these values.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b

# API and storage paths
RAG_API_URL=http://127.0.0.1:8000
RAG_STORAGE_DIR=data/index
RAG_UPLOAD_DIR=data/raw
RAG_MIN_SCORE=0.10
